{
  "expo": {
    "name": "Financial Aid",
    "slug": "financial-aid",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "financial-aid",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.financialaid.mobile"
    },
    "android": {
      "package": "com.financialaid.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0C1E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "mode": "local"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F1128",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-sqlite",
      "expo-asset",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "nl", "de", "tr", "es", "fr", "it", "pt-BR", "ru"],
            "android": ["en", "nl", "de", "tr", "es", "fr", "it", "pt-BR", "ru"]
          }
        }
      ],
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsFileWithMaxCount": 1
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/csv",
              "text/comma-separated-values",
              "application/csv",
              "text/tab-separated-values",
              "application/vnd.ms-excel",
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
              "application/pdf",
              "application/octet-stream"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fc7bf32c-70df-4460-8b01-f0083f9ae8bb"
      }
    }
  }
}
