# Copy to `.env` (gitignored). Expo CLI loads `.env` for every build, a store build included, and
# inlines each `EXPO_PUBLIC_` value when the JavaScript bundle is built. For EAS builds set the same
# names as EAS environment variables. Setup: docs/account.md.

# Account service (Supabase → Project Settings → API). Both are public values, safe in the app.
# Leave both empty for a build without accounts: the account screens are hidden.
# Never put the service role key or the RevenueCat secret key here; they belong to the edge function.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google sign-in (Google Cloud → APIs & Services → Credentials). Empty hides the Google button.
# Web client: the one entered in Supabase → Authentication → Providers → Google.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS client, in the form 1234-abc.apps.googleusercontent.com. Changing it needs a native rebuild:
# app.config.ts turns it into the URL scheme of the iOS project.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Pro testing in a Release build. "1" shows the "Pro (testing)" switch in Settings → Subscription
# and a "TEST BUILD" label at the bottom of Settings. Leave it unset for a production build: the
# switch is then hidden and a stored override is ignored. Do not set it in `.env`; pass it on the
# command line only:
#   EXPO_PUBLIC_PRO_TESTING=1 npx expo run:ios --configuration Release
EXPO_PUBLIC_PRO_TESTING=
